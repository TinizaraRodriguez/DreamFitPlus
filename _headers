# Cabeceras HTTP (las leen Cloudflare Pages y Netlify). Se copian a dist/ al ejecutar `npm run build`.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Los scripts no llevan versión en el nombre: que el navegador compruebe siempre si hay uno nuevo
# (si no ha cambiado responde 304 y no se vuelve a descargar).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/styles.css
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
